{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek-LeanSpark",
  "version": "0.2.0",
  "identifier": "com.deepseek.leanspark",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "DeepSeek-LeanSpark",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:3000 http://127.0.0.1:3000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI 辅助形式化数学工具",
    "longDescription": "DeepSeek V4 大模型 + Lean4 形式化证明助手的桌面应用，支持工作区文件管理、证明依赖图可视化、LaTeX 公式渲染。"
  },
  "plugins": {}
}
